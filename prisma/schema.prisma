// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Admin users (staff who manage the platform) =====
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ===== Referrer partners =====
// Referrers can self-register (passwordHash set) or be created by admin.
// Pipeline: Referrer → Visit → Lead → Contact → Service → Completed → Commission
model Referrer {
  id           String   @id @default(cuid())
  code         String   @unique // e.g. K1024
  displayName  String?
  contact      String?  // mobile
  email        String?
  // Iranian bank account IBAN (شماره شبا), e.g. IR062960000000100324200001
  iban         String?
  passwordHash String?  // set when self-registered; null for admin-created (legacy)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ===== User-submitted help requests =====
model Lead {
  id           String   @id @default(cuid())
  trackingCode String   @unique // e.g. KK-7A3F9X
  fullName     String
  mobile       String
  city         String
  // "claim" | "question" | "assistance"
  requestType  String
  note         String?
  // Hidden referral code captured from ?ref=K1024
  referralCode String?
  // Pipeline status: new -> contacted -> service -> completed | cancelled
  status       String   @default("new")
  // Optional internal admin note (not shown to user)
  adminNote    String?
  userAgent    String?
  source       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([referralCode])
  @@index([status])
  @@index([mobile])
}

// ===== Articles (SEO content managed by admin) =====
model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  content         String    // markdown
  coverUrl        String?
  metaDescription String?
  keywords        String?   // comma-separated
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ===== FAQs (managed by admin, shown on public site) =====
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

// ===== Messages between referrer and admin =====
// Used for the in-app chat: referrers ask questions, admin replies.
// History is preserved for commission/payment notifications.
model Message {
  id         String   @id @default(cuid())
  // The referrer this conversation belongs to (by code)
  referrerCode String
  // "referrer" = sent by referrer; "admin" = sent by admin
  senderType String
  body       String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([referrerCode, createdAt])
  @@index([senderType, readAt])
}

// ===== Site analytics: page-view visits =====
model Visit {
  id        String   @id @default(cuid())
  ip        String?
  path      String
  method    String?
  // Parsed from User-Agent:
  browser   String?  // Chrome, Firefox, Safari, Edge, ...
  platform  String?  // desktop, mobile, tablet
  os        String?  // Windows, macOS, Linux, Android, iOS, ...
  // Raw + referer
  userAgent String?
  referer   String?
  // Unique visitor session (30-min cookie)
  sessionId String?
  // Whether the visit was a bot/crawler
  isBot     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([ip])
  @@index([sessionId])
}
